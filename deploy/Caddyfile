# Serves the built Keston Admin app. Keston ID's Caddy sends
# admin.keston.co here (and its /api to Keston ID).
{
	admin off
	auto_https off
}

:8080 {
	root * /srv
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Content-Security-Policy "frame-ancestors 'none'"
	}
	# Hashed file names: safe to cache for a year. index.html: never.
	header /assets/* Cache-Control "public, max-age=31536000, immutable"

	# Where Keston ID and the Admin API are, from this container's settings
	# (KESTON_ID_URL, KESTON_API_URL), read by the app when it starts. Blank:
	# the app works them out from its own address.
	handle /config.json {
		header Content-Type application/json
		header Cache-Control "no-store"
		respond `{"idUrl":"{$KESTON_ID_URL:}","apiUrl":"{$KESTON_API_URL:}"}` 200
	}

	handle {
		# A page file from an older version is gone: say so (404), rather than
		# sending index.html, so the app can tell and reload (lib/staleBuild.ts).
		# route keeps this before try_files, which Caddy would otherwise run first.
		route {
			@missingAsset {
				path /assets/*
				not file
			}
			respond @missingAsset 404
			try_files {path} /index.html
		}
		@index path /index.html
		header @index Cache-Control "no-cache"
		file_server
	}
}
